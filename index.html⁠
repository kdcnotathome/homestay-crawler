<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>包棟民宿搜尋網</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f5f5f7; margin: 0; padding: 16px; }
        .card { background: white; border-radius: 12px; padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        h1 { font-size: 20px; text-align: center; margin-bottom: 20px; color: #1d1d1f; }
        .filter-group { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }
        label { font-size: 14px; font-weight: bold; color: #424245; }
        select, input[type="number"] { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-size: 16px; box-sizing: border-box; }
        .checkbox-group { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
        .checkbox-label { font-weight: normal; font-size: 14px; display: flex; align-items: center; gap: 4px; }
        button { width: 100%; background: #0071e3; color: white; border: none; padding: 12px; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; }
        .badge { display: inline-block; background: #e8f2ff; color: #0071e3; font-size: 12px; padding: 4px 8px; border-radius: 4px; margin-right: 4px; margin-top: 4px; }
        .price { font-size: 18px; font-weight: bold; color: #ff3b30; }
    </style>
</head>
<body>

    <h1>🏡 包棟民宿搜尋網</h1>

    <div class="card">
        <div class="filter-group">
            <label>選擇縣市：</label>
            <select id="citySelect">
                <option value="">全部地區</option>
                <option value="宜蘭縣">宜蘭縣</option>
                <option value="苗栗縣">苗栗縣</option>
                <option value="南投縣">南投縣</option>
                <option value="屏東縣">屏東縣</option>
            </select>

            <label>最少入住人數：</label>
            <input type="number" id="guestInput" placeholder="例如：10" value="10">

            <label>必須設施：</label>
            <div class="checkbox-group">
                <label class="checkbox-label"><input type="checkbox" id="ktvCheck"> 🎤 KTV</label>
                <label class="checkbox-label"><input type="checkbox" id="bbqCheck"> 🍖 烤肉</label>
                <label class="checkbox-label"><input type="checkbox" id="mahjongCheck"> 🀄 麻將</label>
            </div>
        </div>
        <button onclick="search()">搜尋民宿</button>
    </div>

    <div id="results"></div>

    <script>
        const SUPABASE_URL = "https://minkahnqqkilodlbbvlw.supabase.co";
        const SUPABASE_KEY = "sb_publishable_xhEmJWSXEaG4fEdR8sLH5g_718YiiXM";
        const client = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        async function search() {
            const city = document.getElementById('citySelect').value;
            const minGuests = parseInt(document.getElementById('guestInput').value) || 0;
            const needKtv = document.getElementById('ktvCheck').checked;
            const needBbq = document.getElementById('bbqCheck').checked;
            const needMahjong = document.getElementById('mahjongCheck').checked;

            let query = client.from('homestays').select('*').gte('max_guests', minGuests);

            if (city) query = query.eq('city', city);
            if (needKtv) query = query.eq('has_ktv', true);
            if (needBbq) query = query.eq('has_bbq', true);
            if (needMahjong) query = query.eq('has_mahjong', true);

            const { data, error } = await query;
            const container = document.getElementById('results');
            container.innerHTML = '';

            if (error || !data || data.length === 0) {
                container.innerHTML = '<div class="card"><p style="text-align:center;">查無符合條件的民宿</p></div>';
                return;
            }

            data.forEach(item => {
                container.innerHTML += `
                    <div class="card">
                        <h3>${item.name}</h3>
                        <p>📍 ${item.city}｜可容納 ${item.max_guests} 人</p>
                        <div>
                            ${item.has_ktv ? '<span class="badge">🎤 KTV</span>' : ''}
                            ${item.has_bbq ? '<span class="badge">🍖 烤肉</span>' : ''}
                            ${item.has_mahjong ? '<span class="badge">🀄 麻將</span>' : ''}
                        </div>
                        <p class="price">NT$ ${item.price ? item.price.toLocaleString() : '洽詢'} / 晚</p>
                        <a href="${item.url}" target="_blank" style="color: #0071e3; font-weight: bold; text-decoration: none;">查看民宿詳情 ➔</a>
                    </div>
                `;
            });
        }

        search();
    </script>
</body>
</html>
